---
import Base from "../layouts/Base.astro";
import MarginRail from "../components/MarginRail.astro";
import status from "../data/status.yaml";

const fmt = (d: Date) => d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "2-digit" });
const updated = new Date(status.updated);

const log = [
  {
    date: "2026-06-04",
    entries: [
      "Shipping the first cut of LoopGuard's evaluation-circularity detector. Tuning the correlation threshold against a synthetic dataset.",
      "Reading Inspired by Marty Cagan — slow-cooking the chapters on product discovery.",
      "Rebuilding this site in Astro. It's been a fun reset.",
    ],
  },
  {
    date: "2026-05-21",
    entries: [
      "Wrapped the second pass on the agentic news digest. Click feedback is now a real signal, not a vanity metric.",
      "Started lifting heavier — 4-day push/pull/legs split.",
    ],
  },
];
---
<Base title="Now — Ayush Gupta" description="What I'm working on right now.">
  <div class="page">
    <MarginRail section="06 / Now" filed={fmt(updated)} marks={[
      { label: "Last update", value: fmt(updated) },
    ]} />
    <div class="main">
      <header class="head">
        <p class="kicker">FIELD JOURNAL · 06</p>
        <h1>/now</h1>
        <p class="lede">
          A dated log of what I'm actually working on, reading, and thinking
          about. Updated periodically — inspired by <a href="https://nownownow.com/about" rel="noopener">Derek Sivers' /now page convention</a>.
        </p>
      </header>

      <section class="snapshot">
        <p class="snapshot-row"><span class="lbl">Currently</span><span>{status.currently}</span></p>
        <p class="snapshot-row"><span class="lbl">Reading</span><span>{status.reading}</span></p>
        <p class="snapshot-row"><span class="lbl">Listening</span><span>{status.listening}</span></p>
        <p class="snapshot-row"><span class="lbl">Where</span><span>{status.location}</span></p>
      </section>

      <h2 class="log-title">Log</h2>
      <ol class="log">
        {log.map((entry) => (
          <li>
            <time>{fmt(new Date(entry.date))}</time>
            <ul>
              {entry.entries.map((e) => <li>{e}</li>)}
            </ul>
          </li>
        ))}
      </ol>
    </div>
  </div>
</Base>

<style>
  .head { margin-bottom: var(--s-6); }
  .kicker { font-family: var(--mono); color: var(--muted); font-size: var(--fs-marginalia); letter-spacing: 0.22em; text-transform: uppercase; margin: 0 0 var(--s-3); }
  .head h1 { font-size: clamp(2.4rem, 5vw, 3.6rem); margin: 0 0 var(--s-3); font-family: var(--mono); letter-spacing: -0.02em; }
  .head h1::before { content: "/"; color: var(--signal); }
  .lede { color: var(--ink-soft); max-width: 56ch; margin: 0; }

  .snapshot {
    background: var(--bg-soft);
    border: 1px solid var(--rule);
    padding: var(--s-4);
    margin-bottom: var(--s-7);
    border-radius: 2px;
  }
  .snapshot-row {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: var(--s-3);
    margin: 0;
    padding: 0.4em 0;
    border-bottom: 1px solid var(--rule-soft);
    font-family: var(--mono);
    font-size: 0.92rem;
  }
  .snapshot-row:last-child { border-bottom: 0; }
  .lbl { color: var(--muted); font-size: 0.78rem; letter-spacing: 0.1em; text-transform: uppercase; padding-top: 0.15em; }

  .log-title { font-family: var(--serif); font-size: 1.6rem; margin: 0 0 var(--s-4); }
  .log { list-style: none; padding: 0; margin: 0; }
  .log > li { padding: var(--s-4) 0; border-bottom: 1px solid var(--rule-soft); }
  .log time {
    display: block;
    font-family: var(--mono);
    color: var(--signal);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: var(--s-2);
  }
  .log ul { padding-left: 1.2em; margin: 0; }
  .log ul li { margin: var(--s-2) 0; color: var(--ink-soft); }
</style>
