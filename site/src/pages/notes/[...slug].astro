---
import Base from "../../layouts/Base.astro";
import MarginRail from "../../components/MarginRail.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const wordCount = (post.body ?? "").trim().split(/\s+/).length;
const readingTime = Math.max(1, Math.round(wordCount / 220));
const fmt = (d: Date) => d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "2-digit" });
const kindLabel = post.data.kind.replace("-", " ");
---
<Base title={`${post.data.title} — Ayush Gupta`} description={post.data.description ?? post.data.subtitle}>
  <div class="page">
    <MarginRail
      section={kindLabel.toUpperCase()}
      filed={fmt(post.data.date)}
      marks={[
        { label: "Words", value: wordCount.toLocaleString() },
        { label: "Read", value: `${readingTime} min` },
        ...(post.data.tags?.length ? [{ label: "Tags", value: post.data.tags.join(", ") }] : []),
      ]}
    />
    <article class="main note">
      <header class="head">
        <p class="kicker">{kindLabel} · {fmt(post.data.date)}</p>
        <h1>{post.data.title}</h1>
        {post.data.subtitle && <p class="subtitle">{post.data.subtitle}</p>}
        <div class="byline">
          <span>By Ayush Gupta</span>
          <span class="sep">·</span>
          <span>{readingTime} min read</span>
          <span class="sep">·</span>
          <span>{wordCount.toLocaleString()} words</span>
        </div>
      </header>
      <div class="prose">
        <Content />
      </div>
      <footer class="back">
        <a href="/notes/">← All notes</a>
      </footer>
    </article>
  </div>
</Base>

<style>
  .note .head {
    margin-bottom: var(--s-7);
    padding-bottom: var(--s-5);
    border-bottom: 1px solid var(--rule);
  }
  .kicker {
    font-family: var(--mono); color: var(--signal);
    font-size: var(--fs-marginalia); letter-spacing: 0.18em;
    text-transform: uppercase; margin: 0 0 var(--s-3);
  }
  .note h1 {
    font-family: var(--serif);
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    line-height: 1.02;
    margin: 0 0 var(--s-3);
    letter-spacing: -0.018em;
  }
  .subtitle {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.2rem, 2vw, 1.45rem);
    color: var(--ink-soft);
    line-height: 1.3;
    margin: 0 0 var(--s-4);
    max-width: 50ch;
  }
  .byline {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    display: flex;
    gap: 0.5em;
    flex-wrap: wrap;
  }
  .sep { opacity: 0.4; }

  /* ─── Prose ─────────────────────────────────────────────────────────── */
  .prose {
    font-family: var(--reading);
    font-size: 1.125rem;
    line-height: 1.72;
    color: var(--ink);
    max-width: 64ch;
    font-feature-settings: "kern", "liga", "onum";
  }
  [data-theme="night"] .prose { color: var(--ink-soft); }

  /* Drop cap — only on the FIRST paragraph that is a direct child of .prose */
  .prose :global(> p:first-child::first-letter) {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 4.4em;
    line-height: 0.86;
    float: left;
    padding: 0.05em 0.12em 0 0;
    margin: 0.05em 0 -0.1em -0.04em;
    color: var(--signal);
    font-feature-settings: "lnum";
  }

  /* Paragraphs */
  .prose :global(p) { margin: 0 0 1.1em; }
  .prose :global(p + p) { margin-top: 0; }

  /* Headings — serif, tight, scaled */
  .prose :global(h2) {
    font-family: var(--serif);
    font-size: 1.9rem;
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 2.4em 0 0.5em;
    color: var(--ink);
    font-weight: 400;
  }
  .prose :global(h2)::before {
    content: "§";
    color: var(--signal);
    margin-right: 0.4em;
    font-family: var(--serif);
    font-style: italic;
    opacity: 0.7;
  }
  .prose :global(h3) {
    font-family: var(--serif);
    font-size: 1.35rem;
    line-height: 1.2;
    margin: 2em 0 0.4em;
    color: var(--ink);
    font-weight: 500;
    letter-spacing: -0.005em;
    text-transform: none;
  }
  .prose :global(h4) {
    font-family: var(--mono);
    font-size: 0.85rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--signal);
    margin: 1.8em 0 0.3em;
    font-weight: 700;
  }

  /* Lists */
  .prose :global(ul), .prose :global(ol) {
    margin: 0.4em 0 1.2em;
    padding-left: 1.4em;
  }
  .prose :global(ul) { list-style: none; }
  .prose :global(ul > li) { position: relative; padding-left: 0.2em; }
  .prose :global(ul > li::before) {
    content: "·";
    position: absolute;
    left: -1em;
    top: -0.1em;
    color: var(--signal);
    font-weight: 700;
    font-size: 1.6em;
    line-height: 1;
  }
  .prose :global(ol) { list-style: none; counter-reset: list; }
  .prose :global(ol > li) {
    counter-increment: list;
    position: relative;
    padding-left: 0.3em;
  }
  .prose :global(ol > li::before) {
    content: "[" counter(list) "]";
    position: absolute;
    left: -2.2em;
    color: var(--signal);
    font-family: var(--mono);
    font-size: 0.78em;
    letter-spacing: 0.04em;
    top: 0.42em;
    width: 2em;
    text-align: right;
  }
  .prose :global(li) { margin: 0.45em 0; }
  .prose :global(li > p) { margin: 0 0 0.5em; }
  .prose :global(li > p:last-child) { margin-bottom: 0; }
  .prose :global(li > ul), .prose :global(li > ol) { margin: 0.4em 0; }
  /* Crucial: never apply drop-cap to nested paragraphs */
  .prose :global(li p::first-letter),
  .prose :global(blockquote p::first-letter),
  .prose :global(ul p::first-letter),
  .prose :global(ol p::first-letter) {
    all: unset;
  }

  /* Blockquote — pull-quote feel */
  .prose :global(blockquote) {
    margin: 1.8em 0 1.8em -0.4em;
    padding: 0.1em 0 0.1em 1.2em;
    border-left: 2px solid var(--signal);
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.35rem;
    line-height: 1.4;
    color: var(--ink-soft);
    max-width: 56ch;
  }
  .prose :global(blockquote p) { margin: 0.4em 0; }

  /* Code */
  .prose :global(code) {
    font-family: var(--mono);
    font-size: 0.88em;
    background: var(--bg-soft);
    padding: 0.08em 0.36em;
    border: 1px solid var(--rule-soft);
    border-radius: 2px;
    color: var(--ink);
  }
  .prose :global(pre) {
    font-family: var(--mono);
    background: var(--bg-soft);
    padding: var(--s-4);
    border: 1px solid var(--rule-soft);
    border-radius: 3px;
    overflow-x: auto;
    margin: 1.4em 0;
    font-size: 0.88rem;
    line-height: 1.6;
  }
  .prose :global(pre code) {
    background: none; border: 0; padding: 0; font-size: inherit;
  }

  /* Links */
  .prose :global(a) {
    color: var(--ink);
    border-bottom: 1px solid var(--signal);
    transition: color var(--t-fast) var(--easing), background var(--t-fast) var(--easing);
  }
  .prose :global(a:hover) {
    color: var(--signal);
    background: color-mix(in oklab, var(--signal) 8%, transparent);
  }

  /* Strong/em */
  .prose :global(strong) { font-weight: 600; color: var(--ink); }
  .prose :global(em) { font-style: italic; }

  /* Hairline rule as section break */
  .prose :global(hr) {
    border: 0;
    width: 6em;
    height: 0;
    margin: 2.4em auto;
    border-top: 1px solid var(--rule);
    text-align: center;
    overflow: visible;
  }
  .prose :global(hr::after) {
    content: "❦";
    display: inline-block;
    transform: translateY(-0.7em);
    background: var(--bg);
    padding: 0 0.5em;
    color: var(--signal);
    font-size: 1.1rem;
    font-family: var(--serif);
  }

  /* Tables */
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.4em 0;
    font-family: var(--mono);
    font-size: 0.9rem;
  }
  .prose :global(th), .prose :global(td) {
    padding: 0.55em 0.8em;
    border-bottom: 1px solid var(--rule-soft);
    text-align: left;
  }
  .prose :global(th) {
    border-bottom: 1px solid var(--ink);
    font-family: var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.78rem;
    color: var(--signal);
    font-weight: 700;
  }

  /* Images */
  .prose :global(img) {
    display: block;
    margin: 1.6em auto;
    max-width: 100%;
    height: auto;
    border-radius: 2px;
  }

  /* Footer */
  .back {
    margin-top: var(--s-8);
    padding-top: var(--s-4);
    border-top: 1px solid var(--rule-soft);
    font-family: var(--mono);
    font-size: 0.85rem;
  }

  @media (max-width: 640px) {
    .prose { font-size: 1.06rem; }
    .prose :global(> p:first-child::first-letter) { font-size: 3.6em; }
  }
</style>
