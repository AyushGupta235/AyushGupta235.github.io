  .arrow { display: flex; align-items: center; color: var(--signal); font-family: var(--mono); user-select: none; }

  .lessons { color: var(--muted); font-size: 0.9rem; line-height: 1.6; max-width: 64ch; margin: 0; }
  .lessons-label { font-family: var(--mono); font-size: var(--fs-marginalia); letter-spacing: 0.1em; text-transform: uppercase; }

  /* ---- headings outside bands ---- */
  .more h2, .contact h2 { font-size: var(--fs-h2); line-height: 1.15; margin: 0 0 var(--s-2); }

