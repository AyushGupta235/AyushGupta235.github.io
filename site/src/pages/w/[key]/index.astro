---
// Unlisted work page. Deliberately absent from Nav.astro, CmdK.astro, and rss.xml.
//
// Both the URL slug and the content come from site/private/portfolio.yaml, which
// is gitignored — this public repo therefore reveals neither. CI writes that file
// from the PORTFOLIO_YAML_B64 secret before building. When the file is missing
// (a fresh clone, a fork), getStaticPaths returns no routes and the page is
// simply not built.
//
// Layout: each project is a "chapter" — a dark ink band carrying the headline and
// the before→after delta (the 5-second read), one data graphic that carries the
// project's argument, the pull quote, an impact strip, and the full prose folded
// behind a native <details> disclosure.
import fs from "node:fs";
import path from "node:path";
import yaml from "js-yaml";
import Base from "../../../layouts/Base.astro";
import { iterationsSvg, type IterationsViz } from "./_viz";

type Stat = { label: string; value: string };
type Delta = { before: string; after: string; label: string };
type BarsViz = { max: number; title: string; rows: { label: string; value: number; note?: string; win?: boolean }[]; caption: string };
type MatrixViz = { cols: [string, string]; rows: { label: string; a: string; b: string; better?: "a" | "b" }[]; rule: string; caption: string };
type LatencyViz = { rows: { label: string; ms: number; acc: string; win?: boolean }[]; caption: string };
type RangeViz = { scale: [number, number]; before: number; threshold: number; min: number; mean: number; cases: number; pct99: number; caption: string };
type Project = {
  key: string;
  title: string;
  headline: string;
  domain: string;
  delta: Delta;
  viz: ({ type: "iterations" } & IterationsViz) | ({ type: "bars" } & BarsViz) | ({ type: "matrix" } & MatrixViz) | ({ type: "latency" } & LatencyViz) | ({ type: "range" } & RangeViz);
  subtitle: string;
  stats: Stat[];
  context: string;
  how_it_works: string[];
  pull_quote: string;
  impact: string;
  lessons?: string;
};
type Portfolio = {
  slug: string;
  meta: { title: string; description: string };
  intro: { kicker: string; title: string; lede: string; note?: string };
  featured: Project[];
  overflow: { title: string; one_liner: string }[];
  contact: { email: string; links: { label: string; href: string }[] };
};

export function getStaticPaths() {
  const file = path.join(process.cwd(), "private", "portfolio.yaml");
  if (!fs.existsSync(file)) return [];
  const data = yaml.load(fs.readFileSync(file, "utf8")) as Portfolio;
  return [{ params: { key: data.slug }, props: { data } }];
}

const { data } = Astro.props as { data: Portfolio };
const { intro, featured, overflow, contact } = data;

// scale helpers for the HTML/CSS graphics
const pct = (v: number, lo: number, hi: number) => ((v - lo) / (hi - lo)) * 100;
const LOG_LO = 50, LOG_HI = 60000; // ms
const logPct = (ms: number) => (Math.log10(ms / LOG_LO) / Math.log10(LOG_HI / LOG_LO)) * 100;
const fmtMs = (ms: number) => (ms >= 1000 ? `${Math.round(ms / 1000)} s` : `${ms} ms`);
---

<Base title={data.meta.title} description={data.meta.description} noindex={true}>
  <div class="wpage">
    <nav class="toc" aria-label="Projects">
      <details class="toc-fold" open>
        <summary>
          <span class="toc-head">Projects</span>
          <span class="toc-hint" aria-hidden="true"></span>
        </summary>
        <ol>
          {featured.map((p) => (
            <li>
              <a href={`#${p.key}`} data-spy={p.key}>
                <span class="txt">
                  {p.title}
                  <span class="toc-delta">{p.delta.before} → {p.delta.after}</span>
                </span>
              </a>
            </li>
          ))}
          <li class="sep">
            <a href="#more" data-spy="more"><span class="txt">More work</span></a>
          </li>
          <li>
            <a href="#contact" data-spy="contact"><span class="txt">Contact</span></a>
          </li>
        </ol>
      </details>
    </nav>

    <div class="main">
      <header class="head">
        <p class="kicker">{intro.kicker}</p>
        <h1>{intro.title}</h1>
        <p class="lede">{intro.lede}</p>
        {intro.note && <p class="note">{intro.note}</p>}
      </header>

      {featured.map((p) => (
        <section class="case" id={p.key} aria-labelledby={`${p.key}-t`}>
          <div class="band">
            <p class="band-kicker">PROJECT · {p.domain}</p>
            <h2 id={`${p.key}-t`}>
              <span>{p.headline}</span>
              <a class="anchor" href={`#${p.key}`} data-anchor={p.key} aria-label={`Link to “${p.title}”`}>¶</a>
            </h2>
            <p class="band-sub">{p.subtitle}</p>
            <p class="delta">
              <span class="delta-before">{p.delta.before}</span>
              <span class="delta-arrow" aria-hidden="true">⟶</span>
              <span class="delta-after">{p.delta.after}</span>
              <span class="delta-label">{p.delta.label}</span>
            </p>
          </div>

          <figure class="viz">
            {p.viz.type === "iterations" && (
              <div class="chart-scroll"><Fragment set:html={iterationsSvg(p.viz)} /></div>
            )}

            {p.viz.type === "bars" && (
              <div class="bars">
                <p class="minor">{p.viz.title}</p>
                {p.viz.rows.map((r) => (
                  <div class="lat-row" data-win={r.win ? "true" : undefined}>
                    <span class="g-label">{r.label}</span>
                    <span class="lat-track">
                      <span class="lat-bar" style={`width:${pct(r.value, 0, p.viz.max)}%`}></span>
                      {pct(r.value, 0, p.viz.max) > 75 ? (
                        <span class="db-val in-bar" style={`left:${pct(r.value, 0, p.viz.max)}%`}>{r.value.toFixed(2)}</span>
                      ) : (
                        <span class="db-val" style={`left:calc(${pct(r.value, 0, p.viz.max)}% + 8px)`}>{r.value.toFixed(2)}</span>
                      )}
                    </span>
                    <span class="lat-acc">{r.note}</span>
                  </div>
                ))}
                <div class="lat-axis-row">
                  <span class="g-label"></span>
                  <span class="lat-axis">
                    <span style="left:0%">0</span>
                    <span style="left:50%">0.5</span>
                    <span style="left:100%">1.0</span>
                  </span>
                  <span class="lat-acc"></span>
                </div>
              </div>
            )}

            {p.viz.type === "matrix" && (
              <div class="matrix">
                <div class="mx-row mx-head">
                  <span class="g-label"></span>
                  <span class="mx-cell">{p.viz.cols[0]}</span>
                  <span class="mx-cell">{p.viz.cols[1]}</span>
                </div>
                {p.viz.rows.map((r) => (
                  <div class="mx-row">
                    <span class="g-label">{r.label}</span>
                    <span class={`mx-cell ${r.better === "a" ? "mx-win" : ""}`}>
                      {r.better === "a" && <span class="mx-mark" aria-hidden="true">●</span>}{r.a}
                      {r.better === "a" && <span class="sr-only"> (better)</span>}
                    </span>
                    <span class={`mx-cell ${r.better === "b" ? "mx-win" : ""}`}>
                      {r.better === "b" && <span class="mx-mark" aria-hidden="true">●</span>}{r.b}
                      {r.better === "b" && <span class="sr-only"> (better)</span>}
                    </span>
                  </div>
                ))}
                <p class="mx-rule">{p.viz.rule}</p>
              </div>
            )}

            {p.viz.type === "latency" && (
              <div class="latency">
                {p.viz.rows.map((r) => (
                  <div class="lat-row" data-win={r.win ? "true" : undefined}>
                    <span class="g-label">{r.label}</span>
                    <span class="lat-track">
                      <span class="lat-bar" style={`width:${logPct(r.ms)}%`}></span>
                      {logPct(r.ms) > 75 ? (
                        <span class="db-val in-bar" style={`left:${logPct(r.ms)}%`}>{fmtMs(r.ms)}</span>
                      ) : (
                        <span class="db-val" style={`left:calc(${logPct(r.ms)}% + 8px)`}>{fmtMs(r.ms)}</span>
                      )}
                    </span>
                    <span class="lat-acc">{r.acc}</span>
                  </div>
                ))}
                <div class="lat-axis-row">
                  <span class="g-label"></span>
                  <span class="lat-axis">
                    <span style={`left:${logPct(100)}%`}>100ms</span>
                    <span style={`left:${logPct(1000)}%`}>1s</span>
                    <span style={`left:${logPct(10000)}%`}>10s</span>
                  </span>
                  <span class="lat-acc muted-val">log scale</span>
                </div>
              </div>
            )}

            {p.viz.type === "range" && (
              <div class="range">
                <div class="r-track">
                  <span class="db-dot before" style={`left:${pct(p.viz.before, p.viz.scale[0], p.viz.scale[1])}%`}></span>
                  <span class="r-band" style={`left:${pct(p.viz.min, p.viz.scale[0], p.viz.scale[1])}%; width:${pct(p.viz.scale[1], p.viz.scale[0], p.viz.scale[1]) - pct(p.viz.min, p.viz.scale[0], p.viz.scale[1])}%`}></span>
                  <span class="r-tick" style={`left:${pct(p.viz.threshold, p.viz.scale[0], p.viz.scale[1])}%`}></span>
                  <span class="db-dot after saturated" style={`left:${pct(p.viz.mean, p.viz.scale[0], p.viz.scale[1])}%`}></span>
                </div>
                <div class="r-labels">
                  <span class="r-lab" style={`left:${pct(p.viz.before, p.viz.scale[0], p.viz.scale[1])}%`}><b>{p.viz.before}</b> before</span>
                  <span class="r-lab" style={`left:${pct(p.viz.threshold, p.viz.scale[0], p.viz.scale[1])}%`}>floor {p.viz.threshold}</span>
                  <span class="r-lab under" style={`left:${pct(p.viz.min, p.viz.scale[0], p.viz.scale[1])}%`}>min {p.viz.min}</span>
                  <span class="r-lab strong" style={`left:${pct(p.viz.mean, p.viz.scale[0], p.viz.scale[1])}%`}><b>mean {p.viz.mean}</b></span>
                </div>
                <p class="r-note">{p.viz.cases} cases · {p.viz.pct99}% score ≥ 99</p>
              </div>
            )}

            <figcaption>{p.viz.caption}</figcaption>
          </figure>

          <blockquote class="quote"><p>{p.pull_quote}</p></blockquote>

          <ul class="strip">
            {p.stats.map((s) => (
              <li><span class="strip-value">{s.value}</span><span class="strip-label">{s.label}</span></li>
            ))}
          </ul>

          <details class="log">
            <summary><span class="log-head">Full log</span><span class="log-hint" aria-hidden="true"></span></summary>
            <div class="log-body">
              <p class="body">{p.context}</p>
              <div class="flow-wrap">
                <p class="minor">How it works</p>
                <ol class="flow">
                  {p.how_it_works.map((step, si) => (
                    <>
                      <li class="step">{step}</li>
                      {si < p.how_it_works.length - 1 && <li class="arrow" aria-hidden="true">→</li>}
                    </>
                  ))}
                </ol>
              </div>
              <p class="body">{p.impact}</p>
              {p.lessons && <p class="lessons"><span class="lessons-label">What I'd change —</span> {p.lessons}</p>}
            </div>
          </details>
        </section>
      ))}

      <section class="more" id="more" aria-labelledby="more-t">
        <h2 id="more-t">
          <span>More work</span>
          <a class="anchor" href="#more" data-anchor="more" aria-label="Link to “More work”">¶</a>
        </h2>
        <dl class="overflow">
          {overflow.map((o) => (
            <div class="over-row">
              <dt>{o.title}</dt>
              <dd>{o.one_liner}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section class="contact" id="contact" aria-labelledby="contact-t">
        <h2 id="contact-t">
          <span>Contact</span>
          <a class="anchor" href="#contact" data-anchor="contact" aria-label="Link to “Contact”">¶</a>
        </h2>
        <p class="body">
          Happy to go deeper on any of these — the methodology behind them
          generalizes further than the write-ups do.
        </p>
        <p class="links">
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
          {contact.links.map((l) => (
            <>
              <span class="dot" aria-hidden="true">·</span>
              <a href={l.href}>{l.label}</a>
            </>
          ))}
        </p>
        <p><button class="copy-page" type="button">Copy link to this page</button></p>
      </section>
    </div>
  </div>
</Base>

<style is:global>
  html:has(.wpage) { scroll-behavior: smooth; }
  .wpage .viz svg { display: block; width: 100%; height: auto; min-width: 560px; font-family: var(--mono); }
</style>

<style>
  .wpage {
    display: grid;
    grid-template-columns: 230px minmax(0, var(--content-max)) 1fr;
    gap: var(--gutter);
    max-width: 1080px;
    margin: 0 auto;
    padding: var(--s-6) var(--s-5);
  }

  /* ---- sidebar ---- */
  .toc { grid-column: 1; position: sticky; top: var(--s-5); align-self: start; }
  .toc-fold > summary { list-style: none; cursor: pointer; }
  .toc-fold > summary::-webkit-details-marker { display: none; }
  .toc-head {
    font-family: var(--mono);
    font-size: var(--fs-marginalia);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .toc-hint { display: none; }
  .toc ol { list-style: none; margin: var(--s-3) 0 0; padding: 0; border-left: 1px solid var(--rule); }
  .toc li { margin: 0; }
  .toc li.sep { margin-top: var(--s-3); }
  .toc a {
    display: flex;
    gap: var(--s-2);
    padding: var(--s-2) var(--s-3);
    margin-left: -1px;
    border-left: 2px solid transparent;
    font-family: var(--mono);
    font-size: 0.82rem;
    line-height: 1.35;
    color: var(--muted);
    text-decoration: none;
    transition: color var(--t-fast) var(--easing), border-color var(--t-fast) var(--easing);
  }
  .toc a:hover { color: var(--ink); }
  .toc a[aria-current="true"] { color: var(--signal); border-left-color: var(--signal); }
  .toc .txt { display: flex; flex-direction: column; gap: 0.15em; }
  .toc-delta { font-size: 0.72rem; color: var(--muted); opacity: 0.85; }
  .toc a[aria-current="true"] .toc-delta { color: var(--signal); }

  /* ---- content ---- */
  .main { grid-column: 2; }
  .head { margin-bottom: var(--s-8); }
  .kicker {
    font-family: var(--mono);
    color: var(--muted);
    font-size: var(--fs-marginalia);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin: 0 0 var(--s-3);
  }
  .head h1 { font-size: clamp(2.2rem, 5vw, 3.4rem); margin: 0 0 var(--s-4); }
  .lede { color: var(--ink-soft); max-width: 60ch; margin: 0; font-size: 1.02rem; line-height: 1.6; }
  .note {
    font-family: var(--serif);
    font-style: italic;
    color: var(--muted);
    font-size: 0.95rem;
    max-width: 60ch;
    margin: var(--s-4) 0 0;
  }

  .case, .more, .contact { scroll-margin-top: var(--s-5); margin-bottom: var(--s-9); }
  .more, .contact { padding-bottom: var(--s-7); border-bottom: 1px solid var(--rule-soft); }
  .contact { border-bottom: 0; margin-bottom: var(--s-7); }

  /* ---- chapter band ---- */
  .band {
    position: relative;
    overflow: hidden;
    background: var(--ink);
    color: var(--bg);
    padding: var(--s-6) var(--s-6) var(--s-5);
    margin-bottom: var(--s-6);
  }
  .band-kicker {
    font-family: var(--mono);
    font-size: var(--fs-marginalia);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--signal-soft);
    margin: 0 0 var(--s-3);
  }
  .band h2 {
    font-size: clamp(1.6rem, 3.6vw, 2.3rem);
    line-height: 1.12;
    margin: 0 0 var(--s-2);
    max-width: 22ch;
    position: relative;
    z-index: 1;
  }
  .band-sub {
    font-family: var(--serif);
    font-style: italic;
    font-size: 0.98rem;
    color: color-mix(in srgb, var(--bg) 68%, transparent);
    margin: 0 0 var(--s-5);
    max-width: 52ch;
    position: relative;
    z-index: 1;
  }
  .delta {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-4);
    margin: 0;
    font-family: var(--mono);
    position: relative;
    z-index: 1;
  }
  .delta-before {
    font-size: clamp(2rem, 5.5vw, 3.2rem);
    font-weight: 700;
    line-height: 1;
    color: color-mix(in srgb, var(--bg) 38%, transparent);
  }
  .delta-arrow { color: var(--signal-soft); font-size: 1.3rem; }
  .delta-after {
    font-size: clamp(2rem, 5.5vw, 3.2rem);
    font-weight: 700;
    line-height: 1;
    color: var(--bg);
  }
  .delta-label {
    flex: 1 1 14rem;
    font-size: 0.72rem;
    line-height: 1.5;
    letter-spacing: 0.04em;
    color: color-mix(in srgb, var(--bg) 60%, transparent);
    max-width: 30ch;
  }
  .band .anchor { color: color-mix(in srgb, var(--bg) 35%, transparent); }
  .band .anchor:hover, .band .anchor.is-copied { color: var(--signal-soft); }

  /* ---- graphics: shared ---- */
  .viz { margin: 0 0 var(--s-6); }
  .chart-scroll { overflow-x: auto; }
  .viz figcaption {
    font-family: var(--serif);
    font-style: italic;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.5;
    margin-top: var(--s-3);
    max-width: 62ch;
  }
  .g-label {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--ink-soft);
    line-height: 1.35;
  }
  .g-axis {
    display: flex;
    justify-content: space-between;
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--muted);
    border-top: 1px solid var(--rule);
    padding-top: var(--s-1);
    margin-top: var(--s-2);
  }
  .db-val {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--muted);
    white-space: nowrap;
  }
  .db-val.strong, .db-val.one { color: var(--ink); font-weight: 700; }
  .muted-val { color: var(--muted); }

  /* dots: open = before/rejected, filled = after/confirmed */
  .db-dot {
    position: absolute;
    top: 50%;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    box-sizing: border-box;
  }
  .db-dot.before { border: 1.5px solid var(--muted); background: var(--bg); }
  .db-dot.after { background: var(--signal); border: 2px solid var(--bg); width: 12px; height: 12px; }
  .db-dot.saturated { width: 13px; height: 13px; }

  /* ---- bars (linear scale, reuses latency row anatomy) ---- */
  .bars { border-top: 1px solid var(--rule); padding-top: var(--s-3); }
  .bars .minor { margin-bottom: var(--s-3); }
  .bars .lat-row { grid-template-columns: 210px 1fr 130px; }
  .bars .lat-axis-row { grid-template-columns: 210px 1fr 130px; }
  .bars .lat-axis span:last-child { transform: translateX(-100%); }
  .bars .lat-axis span:first-child { transform: none; }

  /* ---- decision matrix ---- */
  .matrix { border-top: 1px solid var(--rule); padding-top: var(--s-3); }
  .mx-row {
    display: grid;
    grid-template-columns: minmax(150px, 1.4fr) 1fr 1fr;
    gap: var(--s-3);
    align-items: baseline;
    padding: var(--s-3) 0;
    border-bottom: 1px solid var(--rule-soft);
  }
  .mx-head { border-bottom: 1px solid var(--rule); padding-top: 0; }
  .mx-head .mx-cell {
    font-size: var(--fs-marginalia);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 700;
  }
  .mx-cell { font-family: var(--mono); font-size: 0.9rem; color: var(--muted); white-space: nowrap; }
  .mx-cell.mx-win { color: var(--ink); font-weight: 700; }
  .mx-mark { color: var(--signal); font-size: 0.6rem; margin-right: 0.5em; vertical-align: 0.1em; }
  .mx-rule {
    font-family: var(--mono);
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--ink-soft);
    border-left: 2px solid var(--signal);
    padding-left: var(--s-3);
    margin: var(--s-4) 0 0;
    max-width: 58ch;
  }

  /* ---- latency ---- */
  .latency { border-top: 1px solid var(--rule); padding-top: var(--s-3); }
  .lat-row, .lat-axis-row {
    display: grid;
    grid-template-columns: 150px 1fr 110px;
    gap: var(--s-3);
    align-items: center;
    min-height: 2.3rem;
  }
  .lat-track { position: relative; height: 100%; border-left: 1px solid var(--rule); }
  .lat-bar {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    height: 12px;
    background: var(--muted);
    opacity: 0.5;
    border-radius: 0 3px 3px 0;
  }
  .lat-row[data-win] .lat-bar { background: var(--signal); opacity: 1; }
  .db-val.in-bar { transform: translate(-100%, -50%); margin-left: -8px; color: var(--ink); font-weight: 700; }
  .lat-row[data-win] .g-label { color: var(--ink); font-weight: 700; }
  .lat-row[data-win] .db-val { color: var(--ink); font-weight: 700; }
  .lat-acc { font-family: var(--mono); font-size: 0.72rem; color: var(--muted); text-align: right; }
  .lat-axis { position: relative; height: 1.2rem; border-left: 1px solid var(--rule); border-top: 1px solid var(--rule); }
  .lat-axis span {
    position: absolute;
    top: 0.15rem;
    transform: translateX(-50%);
    font-family: var(--mono);
    font-size: 0.68rem;
