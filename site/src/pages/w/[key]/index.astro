  }
  .log > summary:hover .log-head { color: var(--signal); }
  .log-hint { font-family: var(--mono); font-size: var(--fs-marginalia); color: var(--signal); }
  .log[open] .log-hint::before { content: "− collapse"; }
  .log:not([open]) .log-hint::before { content: "+ expand"; }
  .log-body { padding: var(--s-4) 0 0 var(--s-4); border-left: 1px solid var(--rule-soft); }

  .body { color: var(--ink-soft); line-height: 1.7; max-width: 64ch; margin: 0 0 var(--s-5); }

  .flow-wrap { margin: 0 0 var(--s-5); }
  .minor {
    font-family: var(--mono);
    font-size: var(--fs-marginalia);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 var(--s-3);
  }
  .flow { display: flex; flex-wrap: wrap; align-items: stretch; gap: var(--s-2); list-style: none; margin: 0; padding: 0; }
  .step {
    display: flex;
    align-items: center;
    padding: var(--s-2) var(--s-3);
    border: 1px solid var(--rule);
    font-family: var(--mono);
