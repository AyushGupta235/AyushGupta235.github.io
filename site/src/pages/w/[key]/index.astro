</style>

<script is:inline>
  (() => {
    // Scroll-spy: highlight the sidebar entry for whichever section owns the
    // middle of the viewport. Plain anchors already work without any of this.
    const links = document.querySelectorAll("[data-spy]");
    const byKey = new Map();
    links.forEach((a) => byKey.set(a.getAttribute("data-spy"), a));
    const sections = [...byKey.keys()]
      .map((k) => document.getElementById(k))
      .filter(Boolean);

    if ("IntersectionObserver" in window && sections.length) {
      const visible = new Set();
      const paint = () => {
        let top = null;
        for (const s of sections) if (visible.has(s.id)) { top = s.id; break; }
        byKey.forEach((a, k) => {
          if (k === top) a.setAttribute("aria-current", "true");
          else a.removeAttribute("aria-current");
        });
      };
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((en) => {
            if (en.isIntersecting) visible.add(en.target.id);
            else visible.delete(en.target.id);
          });
          paint();
        },
        { rootMargin: "-40% 0px -40% 0px" }
      );
      sections.forEach((s) => io.observe(s));
    }

    // Upgrade the ¶ anchors to copy an absolute deep link. preventDefault only
    // happens in here, so with JS off they stay ordinary working anchors.
    const flash = (el, cls) => {
      el.classList.add(cls);
      setTimeout(() => el.classList.remove(cls), 1400);
    };
    document.querySelectorAll("[data-anchor]").forEach((a) => {
      a.addEventListener("click", (e) => {
        if (!navigator.clipboard) return;
        e.preventDefault();
        const url = location.origin + location.pathname + "#" + a.getAttribute("data-anchor");
        navigator.clipboard.writeText(url).then(() => {
          history.replaceState(null, "", "#" + a.getAttribute("data-anchor"));
          flash(a, "is-copied");
        });
      });
    });

    const copyPage = document.querySelector(".copy-page");
    if (copyPage && navigator.clipboard) {
      copyPage.addEventListener("click", () => {
        navigator.clipboard.writeText(location.origin + location.pathname).then(() => {
          const was = copyPage.textContent;
          copyPage.textContent = "Copied";
          setTimeout(() => (copyPage.textContent = was), 1400);
        });
      });
    }
  })();
</script>
