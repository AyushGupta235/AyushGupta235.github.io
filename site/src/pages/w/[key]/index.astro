  }
  h2:hover .anchor, .anchor:focus-visible { opacity: 1; }
  .anchor:hover { color: var(--signal); }
  .anchor.is-copied { opacity: 1; color: var(--signal); }
  .anchor.is-copied::after { content: " copied"; font-size: 0.85em; letter-spacing: 0.1em; text-transform: uppercase; }
