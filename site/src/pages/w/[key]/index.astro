  .log > summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: baseline; padding: var(--s-2) 0; }
  .log > summary::-webkit-details-marker { display: none; }
  .log-head {
    font-family: var(--mono);
